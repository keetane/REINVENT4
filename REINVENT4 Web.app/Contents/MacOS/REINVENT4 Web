#!/bin/zsh

set -u

REPO_ROOT="/Users/keetane/Documents/modeling/REINVENT4"
WEBAPP_ROOT="$REPO_ROOT/webapp"
BACKEND_ROOT="$WEBAPP_ROOT/backend"
FRONTEND_ROOT="$WEBAPP_ROOT/frontend"
RUN_DIR="$WEBAPP_ROOT/.run"
BACKEND_PYTHON="$BACKEND_ROOT/.venv/bin/python"
REINVENT_PYTHON="/Users/keetane/miniforge3/envs/r4/bin/python"
NODE_BIN="/Users/keetane/.nvm/versions/node/v22.17.0/bin"
APP_URL="http://127.0.0.1:5173/"
HEALTH_URL="http://127.0.0.1:8000/api/health"

mkdir -p "$RUN_DIR"

show_error() {
  local message="$1"
  /usr/bin/open "$RUN_DIR"
  /usr/bin/osascript -e "display alert \"REINVENT4 Webを起動できませんでした\" message \"$message\" as critical" >/dev/null 2>&1
  exit 1
}

pid_is_running() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(<"$pid_file")"
  [[ "$pid" == <-> ]] || return 1
  /bin/kill -0 "$pid" >/dev/null 2>&1
}

[[ -x "$BACKEND_PYTHON" ]] || show_error "バックエンド環境が見つかりません。ログフォルダを確認してください。"
[[ -x "$REINVENT_PYTHON" ]] || show_error "REINVENT4のPython環境が見つかりません。"
[[ -x "$NODE_BIN/npm" ]] || show_error "Node.js環境が見つかりません。"
[[ -d "$FRONTEND_ROOT/node_modules" ]] || show_error "フロントエンド依存関係が見つかりません。"

if ! /usr/bin/curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1; then
  if ! pid_is_running "$RUN_DIR/api.pid"; then
    (
      cd "$BACKEND_ROOT" || exit 1
      /usr/bin/nohup /usr/bin/env \
        PYTHONPATH="$BACKEND_ROOT" \
        REINVENT_WEB_REPOSITORY_ROOT="$REPO_ROOT" \
        REINVENT_WEB_DATABASE_PATH="$REPO_ROOT/jobs.db" \
        REINVENT_WEB_JOBS_DIR="$REPO_ROOT/jobs" \
        REINVENT_WEB_WORKER_RUNNER="reinvent" \
        REINVENT_RUNTIME_PYTHON="$REINVENT_PYTHON" \
        REINVENT_SOURCE_ROOT="$REPO_ROOT" \
        "$BACKEND_PYTHON" -m uvicorn app.main:app --host 127.0.0.1 --port 8000 \
        >>"$RUN_DIR/api.log" 2>&1 &
      echo $! >"$RUN_DIR/api.pid"
    )
  fi
fi

if ! pid_is_running "$RUN_DIR/worker.pid"; then
  (
    cd "$BACKEND_ROOT" || exit 1
    /usr/bin/nohup /usr/bin/env \
      PYTHONPATH="$BACKEND_ROOT" \
      REINVENT_WEB_REPOSITORY_ROOT="$REPO_ROOT" \
      REINVENT_WEB_DATABASE_PATH="$REPO_ROOT/jobs.db" \
      REINVENT_WEB_JOBS_DIR="$REPO_ROOT/jobs" \
      REINVENT_WEB_WORKER_RUNNER="reinvent" \
      REINVENT_RUNTIME_PYTHON="$REINVENT_PYTHON" \
      REINVENT_SOURCE_ROOT="$REPO_ROOT" \
      "$BACKEND_PYTHON" -m worker >>"$RUN_DIR/worker.log" 2>&1 &
    echo $! >"$RUN_DIR/worker.pid"
  )
fi

if ! /usr/bin/curl -fsS --max-time 1 "$APP_URL" >/dev/null 2>&1; then
  if ! pid_is_running "$RUN_DIR/frontend.pid"; then
    (
      cd "$FRONTEND_ROOT" || exit 1
      /usr/bin/nohup /usr/bin/env PATH="$NODE_BIN:/usr/bin:/bin" \
        "$NODE_BIN/npm" run dev -- --host 127.0.0.1 --port 5173 \
        >>"$RUN_DIR/frontend.log" 2>&1 &
      echo $! >"$RUN_DIR/frontend.pid"
    )
  fi
fi

api_ready=false
frontend_ready=false
for _ in {1..240}; do
  /usr/bin/curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1 && api_ready=true
  /usr/bin/curl -fsS --max-time 1 "$APP_URL" >/dev/null 2>&1 && frontend_ready=true
  [[ "$api_ready" == true && "$frontend_ready" == true ]] && break
  /bin/sleep 0.5
done

[[ "$api_ready" == true ]] || show_error "APIが応答しません。api.logを確認してください。"
[[ "$frontend_ready" == true ]] || show_error "Web画面が応答しません。frontend.logを確認してください。"

/usr/bin/osascript -e 'display notification "起動しました" with title "REINVENT4 Web"' >/dev/null 2>&1
/usr/bin/open "$APP_URL"
