REINVENT_WEB_REPOSITORY_ROOT=/absolute/path/to/REINVENT4
REINVENT_WEB_DATABASE_PATH=/absolute/path/to/REINVENT4/jobs.db
REINVENT_WEB_JOBS_DIR=/absolute/path/to/REINVENT4/jobs
REINVENT_WEB_TIMEZONE=Asia/Tokyo
REINVENT_WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REINVENT_WEB_SQLITE_BUSY_TIMEOUT_MS=5000
REINVENT_WEB_WORKER_POLL_SECONDS=2.0
REINVENT_WEB_CANCEL_GRACE_SECONDS=5.0
REINVENT_WEB_RECONCILIATION_GRACE_SECONDS=30.0
REINVENT_WEB_PARENT_MAX_ATOMS=200
REINVENT_WEB_WORKER_RUNNER=fake
REINVENT_RUNTIME_PYTHON=/absolute/path/to/reinvent-runtime/bin/python
REINVENT_SOURCE_ROOT=/absolute/path/to/REINVENT4
